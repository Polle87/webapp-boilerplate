{
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "eslint.useFlatConfig": true,
    "eslint.workingDirectories": [{ "mode": "auto" }],
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "vue",
        "json",
        "jsonc"
    ],
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "chat.tools.terminal.autoApprove": {
        "yarn typecheck": true,
        "yarn workspace @boilerplate/frontend typecheck": true,
        "yarn workspace @boilerplate/backend typecheck": true,
        "yarn lint": true,
        "yarn format:check": true,
        "yarn test": true,
        "yarn test:api": true,
        "yarn test:e2e": true,
        "yarn build": true
    }
}
