{
    "name": "boilerplate",
    "private": true,
    "packageManager": "yarn@4.18.1",
    "engines": {
        "node": ">=24 <25",
        "yarn": "4.18.1"
    },
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "build": "yarn workspaces foreach --all --topological-dev run build",
        "dev": "yarn workspaces foreach --all --parallel --include apps/frontend --include apps/backend run dev",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "yarn test:api && yarn test:e2e",
        "test:api": "playwright test --config=tests/playwright.api.config.ts",
        "test:api:report": "playwright show-report tests/reports/api",
        "test:e2e": "playwright test --config=tests/playwright.e2e.config.ts",
        "test:e2e:report": "playwright show-report tests/reports/e2e",
        "typecheck": "yarn workspaces foreach --all run typecheck"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.63.0",
        "@types/node": "26.6.3",
        "eslint": "10.11.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-jsonc": "3.4.2",
        "eslint-plugin-playwright": "2.12.0",
        "eslint-plugin-prettier": "5.5.6",
        "eslint-plugin-vue": "10.11.1",
        "eslint-plugin-vuejs-accessibility": "2.6.0",
        "globals": "17.13.0",
        "prettier": "3.9.9",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "vue-eslint-parser": "10.4.1"
    },
    "dependenciesMeta": {
        "esbuild": {
            "built": true
        }
    }
}
