{
    "name": "@boilerplate/backend",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "yarn typecheck && node esbuild.config.mjs",
        "dev": "tsx watch src/index.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@libsql/client": "0.18.0",
        "drizzle-orm": "0.45.3",
        "fastify": "5.12.5"
    },
    "devDependencies": {
        "@boilerplate/shared": "workspace:*",
        "@types/node": "26.6.3",
        "drizzle-kit": "0.31.11",
        "esbuild": "0.28.2",
        "tsx": "4.23.15",
        "typescript": "6.0.3"
    }
}
